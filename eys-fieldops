-- 1. Tabla de Centrales / Sitios (Logística de Accesos)
CREATE TABLE centrales (
    id BIGSERIAL PRIMARY KEY,
    operador VARCHAR(50) NOT NULL,
    nombre_sitio VARCHAR(100) NOT NULL,
    geolocalizacion VARCHAR(100),
    ubicacion_llaves TEXT NOT NULL,
    contacto_seguridad TEXT NOT NULL,
    contacto_ingeniero TEXT NOT NULL,
    creado_el TIMESTAMP WITH TIMEZONE DEFAULT CURRENT_TIMESTAMP
);

-- 2. Tabla de Avances Diarios de Instalación (Huawei)
CREATE TABLE reportes_avance (
    id BIGSERIAL PRIMARY KEY,
    central_id BIGINT REFERENCES centrales(id) ON DELETE CASCADE,
    tecnico_nombre VARCHAR(100) NOT NULL,
    descripcion_avance TEXT NOT NULL,
    pendientes_bloqueos TEXT,
    fecha TIMESTAMP WITH TIMEZONE DEFAULT CURRENT_TIMESTAMP
);

-- 3. Tabla de Levantamiento Técnico (TSS)
CREATE TABLE reportes_tss (
    id BIGSERIAL PRIMARY KEY,
    central_id BIGINT REFERENCES centrales(id) ON DELETE CASCADE,
    tecnico_nombre VARCHAR(100) NOT NULL,
    materiales_requeridos JSONB NOT NULL,
    fecha TIMESTAMP WITH TIMEZONE DEFAULT CURRENT_TIMESTAMP
);

